{
  "kiro": {
    "command": [
      "kiro-cli",
      "acp",
      "--agent",
      "engine"
    ],
    "home_env": "KIRO_HOME",
    "expect_mode": "engine",
    "login_mode": "terminal",
    "login": [
      "kiro-cli",
      "login"
    ],
    "status": [
      "kiro-cli",
      "whoami"
    ]
  },
  "claude": {
    "command": [
      "npx",
      "-y",
      "@agentclientprotocol/claude-agent-acp@0.94.0"
    ],
    "home_env": "CLAUDE_CONFIG_DIR",
    "safe_mode": "default",
    "session_meta": {
      "claudeCode": {
        "options": {
          "settingSources": []
        }
      }
    },
    "login_mode": "code",
    "login": [
      "claude",
      "auth",
      "login"
    ],
    "logout": [
      "claude",
      "auth",
      "logout"
    ],
    "status": [
      "claude",
      "auth",
      "status"
    ]
  },
  "codex": {
    "command": [
      "npx",
      "-y",
      "@agentclientprotocol/codex-acp@2.2.2"
    ],
    "home_env": "CODEX_HOME",
    "env": {
      "INITIAL_AGENT_MODE": "read-only"
    },
    "safe_mode": "read-only",
    "home_files": {
      "config.toml": "# acp-starter: 플랫폼 안의 Codex가 레포의 AGENTS.md(개발 안내)를 읽지 않게 한다.\nproject_doc_max_bytes = 0\n"
    },
    "login_mode": "device",
    "login": [
      "codex",
      "login",
      "--device-auth"
    ],
    "logout": [
      "codex",
      "logout"
    ],
    "status": [
      "codex",
      "login",
      "status"
    ]
  }
}
